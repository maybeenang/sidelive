# Dependencies
node_modules/
frontend/node_modules/

# Generated frontend output. The desktop build task copies this output into
# cmd/sidelive/frontend before compiling the Wails binary.
frontend/dist/
cmd/sidelive/frontend/*
!cmd/sidelive/frontend/.gitkeep

# Compiled applications and test/coverage output
bin/
dist/
build/
coverage/
*.out
*.test
*.prof

# TypeScript and tooling caches
*.tsbuildinfo
.vite/
.vitest/
.turbo/
.cache/

# Local configuration, secrets, and logs
.env
.env.*
!.env.example
*.local
*.log

# IDE/editor metadata
.idea/
.vscode/
*.swp
*.swo
*~

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini

# Locally captured UI artifacts
docs/screenshots/
